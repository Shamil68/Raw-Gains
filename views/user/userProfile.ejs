<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RawGains - User Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content {
            flex: 1 0 auto;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            display: flex;
        }

        .sidebar {
            width: 250px;
            background-color: #383636;
            padding: 20px;
            height: calc(100vh - 120px);
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.5);
            margin-top: 60px;
        }

        .sidebar h2 {
            color: #ff5722;
            font-size: 1.5em;
            margin-bottom: 20px;
        }

        .sidebar a {
            color: #ffffff;
            text-decoration: none;
            padding: 10px;
            margin: 5px 0;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .sidebar a:hover {
            background-color: #2c2c2c;
        }

        .sidebar a.active {
            background-color: #ff5722;
            color: #ffffff;
        }

        .main-content {
            flex: 1;
            padding: 0 20px;
            margin-left: 270px;
        }

        .container {
            background-color: #383636;
            border-radius: 10px;
            padding: 40px;
            max-width: 600px;
            margin: 0 auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        h1 {
            color: #ff5722;
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .profile-section {
            margin-top: 20px;
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 20px;
            border: 2px solid #ff5722;
            cursor: pointer;
        }

        .user-details p {
            font-size: 1.2em;
            margin: 10px 0;
        }

        .user-details a {
            color: #3498db;
            text-decoration: none;
            font-size: 1em;
            margin-top: 5px;
            display: block;
            transition: color 0.3s ease;
        }

        .user-details a:hover {
            color: #2980b9;
            text-decoration: underline;
        }

        .edit-btn {
            background-color: #ff5722;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            margin-top: 20px;
            transition: background-color 0.3s;
        }

        .edit-btn:hover {
            background-color: #e64a19;
        }

        .file-input {
            display: none;
        }

        @media (max-width: 768px) {
            .content {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: static;
                margin-top: 0;
            }

            .main-content {
                margin-left: 0;
                padding: 0;
            }

            .container {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <%- include('../../views/partials/user/header') %>

    <div class="content">
        <div class="sidebar">
            <h2>My Account</h2>
            <a href="/profile" class="active">Account Details</a>
            <a href="/addresses">Address</a>
            <a href="/orders">Orders</a>
            <a href="/wishlist">Wishlist</a>
            <a href="/cart">Cart</a>
            <a href="/wallet">Wallet</a>
        </div>

        <div class="main-content">
            <div class="container" style="margin-top: 60px;">
                <h1>RawGains Profile</h1>

                <!-- Profile Section -->
                <div class="profile-section">
                    <img src="<%= user.avatar %>" alt="Profile Image" class="profile-image" id="profileImage">
                    <form id="uploadForm" action="/update-profile-picture" method="POST" enctype="multipart/form-data">
                        <input type="file" name="profilePicture" id="fileInput" class="file-input" accept="image/*">
                    </form>
                    <div class="user-details">
                        <p><strong>Name:</strong> <%= user.username %></p>
                        <p><strong>Email:</strong> <%= user.email %></p>
                        <!-- <a href="/changeEmail" onclick="verifyCurrentEmailPage(event)">Change Email?</a> -->
                        <p><strong>Password:</strong> <%= user.googleId ? 'Set via Google' : (user.password ? '********' : 'Not set') %></p>
                        <!-- <a href="/changePassword" onclick="updatePasswordPage(event)">Change Password?</a> -->
                    </div>
                    <button class="edit-btn" onclick="redirectToEditProfile(event)">Edit Profile</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../../views/partials/user/footer') %>

    <script>

        const uploadForm = document.getElementById('uploadForm');
        const profileImage = document.getElementById('profileImage');
const fileInput = document.getElementById('fileInput');

// Trigger file input when profile image is clicked
profileImage.addEventListener('click', () => {
    fileInput.click();
});

// Handle file selection and upload via fetch
fileInput.addEventListener('change', async (e) => {
    const file = fileInput.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('profilePicture', file); // name must match your multer field in backend

    try {
        const res = await fetch('/update-profile-picture', {
            method: 'POST',
            body: formData,
            credentials: 'include' // if using session auth
        });

        const data = await res.json();

        if (res.ok) {
            profileImage.src = URL.createObjectURL(file); // preview new image
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: data.message || 'Profile picture updated!'
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: data.message || 'Failed to update profile picture'
            });
        }
    } catch (err) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Server not reachable'
        });
    }
});


function redirectToEditProfile(event) {
    event.preventDefault()
        window.location.href = '/edit-profile';
    }

    // function verifyCurrentEmailPage(event) {
    //     event.preventDefault();
    //     window.location.href = '/change-email';
    // }

    // function updatePasswordPage(event) {
    //     event.preventDefault();
    //     window.location.href = '/change-password';
    // }



</script>
</body>
</html>