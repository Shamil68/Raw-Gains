<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RawGains - User Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content {
            flex: 1 0 auto;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            display: flex;
        }

        .sidebar {
            width: 250px;
            background-color: #383636;
            padding: 20px;
            height: calc(100vh - 120px);
            /* Adjust for header/footer (assuming 60px each) */
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.5);
            margin-top: 60px;
            /* Push below header */
        }

        .sidebar h2 {
            color: #ff5722;
            font-size: 1.5em;
            margin-bottom: 20px;
        }

        .sidebar a {
            color: #ffffff;
            text-decoration: none;
            padding: 10px;
            margin: 5px 0;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .sidebar a:hover {
            background-color: #2c2c2c;
        }

        .sidebar a.active {
            background-color: #ff5722;
            color: #ffffff;
        }

        .main-content {
            flex: 1;
            padding: 0 20px;
            margin-left: 270px;
            /* Sidebar width + padding */
        }

        .container {
            background-color: #383636;
            /* margin-top: 160px; */
            border-radius: 10px;
            padding: 40px;
            max-width: 600px;
            margin: 0 auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        h1 {
            color: #ff5722;
            font-size: 2.5em;
            margin-bottom: 10px;
            /* Reduced to fit image closer */
        }

        .profile-section {
            margin-top: 20px;
            /* Space after heading */
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 20px;
            /* Centered below heading */
            border: 2px solid #ff5722;
        }

        .user-details p {
            font-size: 1.2em;
            margin: 10px 0;
        }

        .edit-btn {
            background-color: #ff5722;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            margin-top: 20px;
            transition: background-color 0.3s;
        }

        .edit-btn:hover {
            background-color: #e64a19;
        }

        #profilePic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            cursor: pointer;
            border: 3px solid #4CAF50;
            transition: 0.3s;
        }

        #profilePic:hover {
            opacity: 0.8;
            transform: scale(1.05);
        }


        
