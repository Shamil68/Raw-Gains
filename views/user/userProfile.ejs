        @media (max-width: 768px) {
            .content {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: static;
                margin-top: 0;
            }

            .main-content {
                margin-left: 0;
                padding: 0;
            }

            .container {
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <%- include('../../views/partials/user/header') %>

        <div class="content">
            <div class="sidebar">
                <h2>My Account</h2>
                <a href="/profile" class="active">Account Details</a>
                <a href="/addresses">Address</a>
                <a href="/orders">Orders</a>
                <a href="/wishlist">Wishlist</a>
                <a href="/cart">Cart</a>
                <a href="/wallet">Wallet</a>
            </div>

            <div class="main-content">
                <div class="container" style="margin-top: 60px;">
                    <h1>RawGains Profile</h1>

                    <!-- Profile Section -->
                    <div class="profile-section">

                        <img id="profile-pic" src="uploads/customer3.jpeg"  alt="Profile Image" class="profile-image">;
   
                         <!-- <div class="edit-icon"> -->
                       <!-- <i class="fa fa-pencil"></i> -->
                        <!-- </div> -->
                        <input type="file" id="fileInput" accept="image/*" style="display: none;" />
                        <div class="user-details">
                            <p><strong>Name:</strong>
                                <%= user.username %>
                            </p>
                            <p><strong>Email:</strong>
                                <%= user.email %>
                            </p>
                            <a href="/change-email" onclick="verifyCurrentEmailPage()"
                                style="color: rgb(110, 147, 235);">Change email?</a>

                            <p><strong>Password:</strong>
                                <%= user.googleId ? 'Set via google' : (user.password ? '********' : 'Not set' ) %>
                            </p>
                            <a href="/change-password" onclick="updatePasswordPage(event)"
                                style="color:rgb(110, 147, 235); ;">Change Password?</a>
                        </div>

                        <button class="edit-btn" onclick="redirectToEditProfile(event)">Edit Profile</button>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../../views/partials/user/footer') %>

            <script>
                function redirectToEditProfile() {
                    window.location.href = '/edit-profile';
                }

                function verifyCurrentEmailPage(event) {
                    event.preventDefault()
                    window.location.href = '/change-email'
                }

                function updatePasswordPage(event) {
                    event.preventDefault()
                    window.location.href = '/change-password'
                }

                const profilePic = document.getElementById('profilePic');
                const fileInput = document.getElementById('fileInput');
                const editIcon = document.querySelector('.edit-icon');


                profilePic.addEventListener('click', () => {
                    fileInput.click();
                });

                fileInput.addEventListener('change', (event) => {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = (e) => {
                            profilePic.src = e.target.result; // Preview the selected image
                        };
                        reader.readAsDataURL(file);
                    }
                });



            </script>
</body>

</html>