<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-commerce - Forgot Password</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f0f0f0;
        }
        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
        }
        .error {
            color: red;
            font-size: 0.9em;
            text-align: left;
            margin: 5px 0 10px 0;
        }
        .form-box {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            width: 300px;
            text-align: center;
        }
        .form-box h2 {
            margin-bottom: 20px;
        }
        .form-box input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .form-box button {
            width: 100%;
            padding: 10px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .form-box button:hover {
            background-color: #218838;
        }
        .form-box a {
            color: #007bff;
            text-decoration: none;
            display: block;
            margin-top: 10px;
        }
        .form-box a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-box">
            <h2>Forgot Password</h2>
            <p>Enter your email to receive a password reset OTP</p>
            <form id="forgot-password-form" action="/forgot-password" method="POST">
                <input type="email" name="email" placeholder="Email" id="email">
                <div class="error" id="email-error"></div>
                <button type="submit">Send OTP</button>
                <a href="/login">Back to Login</a>
            </form>
        </div>
    </div>

    <script>

        const form = document.getElementById('forgot-password-form')
        form.addEventListener('submit',async(e)=>{
            e.preventDefault()

            document.querySelectorAll('.error').forEach(element => element.textContent = '')

            const email = document.getElementById('email').value.trim()

            let isValid = true

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

            if(!email){
                document.getElementById('email-error').textContent = 'Email is required'
                isValid = false
            }else if(!emailRegex.test(email)){
                document.getElementById('email-error').textContent = 'Email must be valid'
                isValid = false
            }

            if(!isValid) return

            try{
                const res = await fetch('/forgot-password',{
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({email:email.toLowerCase()})
                })

                const data = await res.json()

                if(res.status === 400){
                    Swal.fire({
                        icon:'error',
                        title:'Oops...',
                        text:data.message

                    })
                }else if(res.ok){
                    Swal.fire({
                        icon:'success',
                        title:'OTP send',
                        text:'Check your email for the otp'

                    }).then(()=>{
                        window.location.href = data.redirect
                    })

                }else{
                    Swal.fire({
                        icon:'error',
                        title:'Something went wrong',
                        text:data.message
                    })
                }
            }catch(error){
                Swal.fire({
                    icon:"error",
                    title:'error',
                    text:'Server not reachable'
                })
            }

        })



    </script>
</body>
</html>