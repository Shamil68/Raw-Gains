<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RawGains - My Addresses</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content {
            flex: 1 0 auto;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            display: flex;
        }

        .sidebar {
            width: 250px;
            background-color: #383636;
            padding: 20px;
            height: calc(100vh - 120px);
            position: relative;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.5);
            margin-top: 60px;
        }

        .sidebar h2 {
            color: #ff5722;
            font-size: 1.5em;
            margin-bottom: 20px;
        }

        .sidebar a {
            color: #ffffff;
            text-decoration: none;
            padding: 10px;
            margin: 5px 0;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .sidebar a:hover {
            background-color: #2c2c2c;
        }

        .sidebar a.active {
            background-color: #ff5722;
            color: #ffffff;
        }

        .main-content {
            flex: 1;
            padding: 0 20px;
            margin-left: 270px;
        }

        .container {
            background-color: #383636;
            border-radius: 10px;
            padding: 40px;
            max-width: 900px;
            margin: 60px auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        h1 {
            color: #ff5722;
            font-size: 2.3em;
            margin-bottom: 20px;
        }

        .no-addresses {
            font-size: 1.2em;
            color: #888;
        }

        .add-button {
            background-color: #ff5722;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            margin-top: 10px;
            transition: background-color 0.3s;
        }

        .add-button:hover {
            background-color: #e64a19;
        }

        /* ---------- Address Card Styling ---------- */

        .address-list {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .address-card {
            background: #fff;
            color: #000;
            border-left: 4px solid #ffb400;
            border-radius: 10px;
            padding: 25px 30px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
            text-align: left;
            line-height: 1.6;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .address-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
        }

        .address-card h3 {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 6px;
        }

        .address-card p {
            margin: 2px 0;
            font-size: 0.95rem;
        }

        .address-actions {
            margin-top: 12px;
            display: flex;
            gap: 15px;
        }

        .edit-button,
        .delete-button {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .edit-button {
            color: #ffb400;
        }

        .delete-button {
            color: #e53935;
        }

        .edit-button:hover,
        .delete-button:hover {
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            .content {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: static;
                margin-top: 0;
            }

            .main-content {
                margin-left: 0;
                padding: 0;
            }

            .container {
                padding: 20px;
            }

            .address-card {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <%- include('../../views/partials/user/header') %>

    <div class="content">
        <div class="sidebar">
            <h2>My Account</h2>
            <a href="/profile">Account Details</a>
            <a href="/addresses" class="active">Address</a>
            <a href="/orders">Orders</a>
            <a href="/wishlist">Wishlist</a>
            <a href="/cart">Cart</a>
            <a href="/wallet">Wallet</a>
        </div>

        <div class="main-content">
            <div class="container">
                <h1>My Addresses</h1>
                <button class="add-button" onclick="window.location.href='/add-address'">Add New Address</button>

                <% if (!addresses || addresses.length === 0) { %>
                    <div class="no-addresses">No addresses added yet.</div>
                <% } else { %>
                    <div class="address-list">
                        <% addresses.forEach(address => { %>
                            <div class="address-card">
                                <h3>Shipping Address: <%= address.addressType %></h3>
                                <p><strong>Name:</strong> <%= address.fullName %></p>
                                <p>Ph No: <%= address.phone %></p>
                                <br>
                                <p><%= address.streetAddress %></p>
                                <% if (address.landmark) { %>
                                    <p><%= address.landmark %></p>
                                <% } %>
                                <p><%= address.city %>, <%= address.pincode %></p>
                                <p><%= address.state %>, <%= address.country %></p>

                                <div class="address-actions">
                                    <button class="edit-button" onclick="window.location.href='/edit-address/<%= address._id %>'">✏️ Edit</button>
                                    <button class="delete-button" onclick="deleteAddress('<%= address._id %>')">🗑️ Delete</button>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../../views/partials/user/footer') %>

    <script>

        async function deleteAddress(addressId){
            const result = await Swal.fire({
                icon:'warning',
                title:'Are you sure?',
                text:'You wont be able to retrieve this',
                showCancelButton:true,
                cancelButtonColor:'#3085d6',
                confirmButtonColor:'#d33',
                confirmButtonText:'Yes,delete it'

            })

            if(result.isConfirmed){
                try{
                    const res = await fetch(`/delete-address/${addressId}`,{
                        method:'DELETE',
                        headers:{'Content-Type':'application/json'}
                    })

                    const data = await res.json()

                    if(res.ok){
                         Swal.fire({
                    icon:'success',
                    title:'Success',
                    text:'Address deleted successfully'

                    }).then(()=>{
                        window.location.href=data.redirect
                    })
                }else{
                    Swal.fire({
                        icon:'error',
                        title:'error',
                        text:data.message

                    })
                }
                
                }catch(error){
                    Swal.fire({
                        icon:'error',
                        title:'error',
                        text:'Server error'
                    })
                }
            }
        }
        
</script>
</body>
</html>