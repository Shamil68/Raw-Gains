<%- include("../../views/partials/admin/header") %>

<style>
    .main-content {
        padding: 2rem;
        background-color: #f8f9fa;
        min-height: calc(100vh - 160px);
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        color: #FF6B00;
    }

    .tabs {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        border-bottom: 2px solid #ddd;
    }

    .tab-button {
        padding: 0.75rem 1.5rem;
        border: none;
        background: none;
        cursor: pointer;
        font-weight: 500;
        color: #6c757d;
        transition: all 0.3s ease;
    }

    .tab-button.active {
        color: #FF6B00;
        border-bottom: 2px solid #FF6B00;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .search-container {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        max-width: 600px;
    }

    .search-input {
        flex-grow: 1;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .search-input:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: #FF6B00;
        color: white;
    }

    .btn-primary:hover {
        background-color: #e65b00;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }

    .btn-outline:hover {
        background-color: #f1f3f5;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .product-table th,
    .product-table td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .product-table th {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #2c3e50;
    }

    .product-table tr:hover {
        background-color: #f1f3f5;
    }

    .action-btn {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        border-radius: 6px;
        margin-right: 0.5rem;
    }

    .edit-btn {
        background-color: #3498db;
        color: white;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        border: none;
    }

    .block-btn,
    .unblock-btn {
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        color: white;
        border: none;
    }

    .unblock-btn {
        background-color: #e3342f;
    }

    .unblock-btn:hover {
        background-color: #c53030;
    }

    .block-btn {
        background-color: #38a169;
    }

    .block-btn:hover {
        background-color: #2f855a;
    }

    .delete-btn {
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        color: white;
        background-color: rgb(232, 7, 7);
        border: none;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
    }

    .pagination {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
    }

    .pagination li {
        padding: 0.5rem 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .pagination li.active {
        background-color: #FF6B00;
        color: white;
        border-color: #FF6B00;
    }

    .pagination li:hover:not(.disabled) {
        background-color: #f1f3f5;
    }

    .pagination li.disabled {
        color: #6c757d;
        cursor: not-allowed;
    }

    .form-container {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .form-header {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #ddd;
    }

    .form-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .form-header p {
        color: #6c757d;
        margin-top: 0.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #2c3e50;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .input-with-icon {
        position: relative;
    }

    .input-icon {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
    }

    .error {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .image-upload-container {
        border: 2px dashed #ddd;
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .image-upload-container:hover {
        border-color: #FF6B00;
    }

    .image-upload-container.dragover {
        border-color: #FF6B00;
        background-color: rgba(255, 107, 0, 0.05);
    }

    .upload-icon {
        font-size: 2rem;
        color: #6c757d;
        margin-bottom: 1rem;
    }

    .upload-text {
        color: #6c757d;
        margin-bottom: 1rem;
    }

    .upload-text strong {
        color: #FF6B00;
    }

    .browse-btn {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background-color: #f1f3f5;
        border-radius: 6px;
        color: #2c3e50;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .browse-btn:hover {
        background-color: #e2e6ea;
    }

    #image-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .preview-item {
        position: relative;
        width: 120px;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .preview-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .remove-image {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background-color: rgba(220, 53, 69, 0.8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        transition: all 0.3s ease;
    }

    .remove-image:hover {
        background-color: #dc3545;
    }

    .crop-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        padding: 2px 5px;
        background-color: #2ecc71;
        color: white;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 0.75rem;
    }

    .crop-btn:hover {
        background-color: #27ae60;
    }

    .form-actions {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #ddd;
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    @media (max-width: 992px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .main-content {
            padding: 1rem;
        }

        .tabs {
            flex-direction: column;
        }

        .tab-button {
            padding: 0.5rem 1rem;
        }

        .form-container {
            padding: 1.5rem;
        }
        
        .form-actions {
            flex-direction: column;
        }
        
        .btn {
            width: 100%;
        }

        .modal-body {
            padding: 15px;
        }

        #cropper-container {
            max-width: 100%;
        }
    }
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Product Management</h1>
        <div class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a>
            <span>/</span>
            <span>Products</span>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
        <button class="tab-button active" onclick="openTab('productList')">Product List</button>
        <button class="tab-button" onclick="openTab('addProduct')">Add Product</button>
    </div>

    <!-- Product List Tab -->
    <div id="productList" class="tab-content active">
        <!-- Search and Clear -->
        <div class="search-container">
            <input type="text" id="searchInput" class="search-input" placeholder="Search by product name..." value="<%= searchQuery || '' %>">
            <button id="search-btn" style="background:none; border:none; cursor:pointer;">
                <i class="fa-solid fa-magnifying-glass" style="font-size:20px; color:green;"></i>
            </button>
            <button class="btn btn-primary" id="clearSearch">Clear</button>
        </div>

        <!-- Product Table -->
        <table class="product-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Regular Price</th>
                    <th>Sale Price</th>
                    <th>Quantity</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                <% if (products.length === 0) { %>
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--gray); padding: 20px;">No Products found</td>
                    </tr>
                <% } else { %>
                    <% products.forEach((product, index) => { %>
                        <tr>
                            <td><%= (currentPage - 1) * limit + index + 1 %></td>
                            <td>
                                <% if (product.productImage && product.productImage.length > 0) { %>
                                    <% product.productImage.forEach(img => { %>
                                        <img src="<%= img %>" alt="<%= product.productName %>" style="width:50px;height:50px;object-fit:cover;margin-right:5px;">
                                    <% }) %>
                                <% } else { %>
                                    <span>No image</span>
                                <% } %>
                            </td>
                            <td><%= product.productName %></td>
                            <td><%= product.regularPrice.toFixed(2) %></td>
                            <td><%= product.salePrice.toFixed(2) %></td>
                            <td><%= product.quantity %></td>
                            <td><%= product.category ? product.category.name : 'Uncategorized' %></td>
                            <td><%= product.status || 'Active' %></td>
                            <td>
                                <button class="edit-btn" id="edit-btn" onclick="window.location.href='/admin/edit-product/<%= product._id %>'">Edit</button>
                                <% if (product.status === 'Inactive') { %>
                                    <button class="block-btn" id="block-btn" onclick="toggleStatus('<%= product._id %>', 'unblock')">Unblock</button>
                                <% } else { %>
                                    <button class="unblock-btn" id="unblock-btn" onclick="toggleStatus('<%= product._id %>', 'block')">Block</button>
                                <% } %>
                                <!-- <button onclick="deleteProduct('<%= product._id %>')" style="background:none; border:none; cursor:pointer;">
                                    <span class="material-icons" style="font-size:25px; color:red; text-align: center;">delete</span>
                                </button> -->
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="pagination-container">
            <ul class="pagination">
                <li class="<%= currentPage === 1 ? 'disabled' : '' %>" onclick="<%= currentPage === 1 ? '' : `window.location.href='/admin/products?page=${currentPage - 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Previous</li>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="<%= currentPage === i ? 'active' : '' %>" onclick="window.location.href='/admin/products?page=<%= i %>&search=<%= encodeURIComponent(searchQuery || '') %>'"><%= i %></li>
                <% } %>
                <li class="<%= currentPage === totalPages ? 'disabled' : '' %>" onclick="<%= currentPage === totalPages ? '' : `window.location.href='/admin/products?page=${currentPage + 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Next</li>
            </ul>           
        </div>
    </div>

    <!-- Add Product Tab -->
    <div id="addProduct" class="tab-content">
        <div class="form-container">
            <div class="form-header">
                <h2>Product Information</h2>
                <p>Fill in the details below to add a new product to your store</p>
            </div>

            <form id="add-product-form" action="/admin/add-product" method="POST" enctype="multipart/form-data">
                <div class="form-grid">
                    <!-- Product Name -->
                    <div class="form-group full-width">
                        <label for="productName">Product Name</label>
                        <div class="input-with-icon">
                            <input type="text" name="productName" id="productName" class="form-control" placeholder="Enter product name">
                            <i class="fas fa-box input-icon"></i>
                        </div>
                        <span class="error" id="name-error"></span>
                    </div>

                    <!-- Description -->
                    <div class="form-group full-width">
                        <label for="description">Description</label>
                        <textarea name="description" id="description" class="form-control" placeholder="Enter product description" rows="4"></textarea>
                        <span class="error" id="description-error"></span>
                    </div>

                    <!-- Regular Price -->
                    <div class="form-group">
                        <label for="regularPrice">Regular Price ($)</label>
                        <div class="input-with-icon">
                            <input type="number" name="regularPrice" id="regularPrice" class="form-control" placeholder="0.00" step="0.01" min="0">
                            <i class="fas fa-dollar-sign input-icon"></i>
                        </div>
                        <span class="error" id="regularPrice-error"></span>
                    </div>

                    <!-- Sale Price -->
                    <div class="form-group">
                        <label for="salePrice">Sale Price ($)</label>
                        <div class="input-with-icon">
                            <input type="number" name="salePrice" id="salePrice" class="form-control" placeholder="0.00" step="0.01" min="0">
                            <i class="fas fa-dollar-sign input-icon"></i>
                        </div>
                        <span class="error" id="salePrice-error"></span>
                    </div>

                    <!-- Quantity -->
                    <div class="form-group">
                        <label for="quantity">Quantity</label>
                        <div class="input-with-icon">
                            <input type="number" name="quantity" id="quantity" class="form-control" placeholder="0" min="0">
                            <i class="fas fa-cubes input-icon"></i>
                        </div>
                        <span class="error" id="quantity-error"></span>
                    </div>

                    <!-- Category -->
                    <div class="form-group">
                        <label for="category">Category *</label>
                        <select name="category" id="category" class="form-control">
                            <option value="" disabled selected>Select a category</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat._id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                        <span class="error" id="category-error"></span>
                    </div>

                    <!-- Image Upload -->
                    <div class="form-group full-width">
                        <label>Product Images * (Minimum 3 required)</label>
                        <div class="image-upload-container" id="upload-area">
                            <div class="upload-icon">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>
                            <p class="upload-text">Drag & drop images here or <strong>browse</strong></p>
                            <div class="browse-btn">Select Images</div>
                            <input type="file" id="images" name="images" multiple accept="image/*" style="display: none;">
                        </div>
                        <span class="error" id="images-error"></span>
                        <div id="image-preview"></div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="openTab('productList')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Product</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" aria-labelledby="cropperModalLabel" aria-hidden="true" hidden>
    <div class="modal-dialog modal-xl" >
        <div class="modal-content" >
            <div class="modal-header">
                <h5 class="modal-title" id="cropperModalLabel">Crop Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="cropper-container">
                    <img id="cropper-image" src="" alt="Image to Crop">
                </div>
                <div class="cropper-actions">
                    <button type="button" class="btn btn-primary" id="cropImageBtn">Crop & Save</button>
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
