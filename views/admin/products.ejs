<%- include("../../views/partials/admin/header") %>

<style>
    /* Main content area */
    .main-content {
        padding: 2rem;
        background-color: #f8f9fa;
        min-height: calc(100vh - 160px);
        font-family: 'Inter', sans-serif;
    }

    /* Page header */
    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        color: #FF6B00;
    }

    /* Search bar */
    .search-container {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        max-width: 600px;
    }

    .search-input {
        flex-grow: 1;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .search-input:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: #FF6B00;
        color: white;
    }

    .btn-primary:hover {
        background-color: #e65b00;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }

    .btn-outline:hover {
        background-color: #f1f3f5;
    }

    /* Table styling */
    .product-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .product-table th,
    .product-table td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .product-table th {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #2c3e50;
    }

    .product-table tr:hover {
        background-color: #f1f3f5;
    }

    .action-btn {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        border-radius: 6px;
        margin-right: 0.5rem;
    }

    .edit-btn {
        background-color: #3498db;
        color: white;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        border: none;
    }

   .block-btn, .unblock-btn {
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        color: white;
        border: none;
    }

    .unblock-btn {
        background-color: #e3342f;
    }

    .unblock-btn:hover {
        background-color: #c53030;
    }

    .block-btn {
        background-color: #38a169;
    }

    .block-btn:hover {
        background-color: #2f855a;
    }
    .delete-btn{
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        color: white;
        background-color: rgb(232, 7, 7);
        border: none;
    }

    /* Pagination styling */
    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
    }

    .pagination {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
    }

    .pagination li {
        padding: 0.5rem 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .pagination li.active {
        background-color: #FF6B00;
        color: white;
        border-color: #FF6B00;
    }

    .pagination li:hover:not(.disabled) {
        background-color: #f1f3f5;
    }

    .pagination li.disabled {
        color: #6c757d;
        cursor: not-allowed;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .main-content {
            padding: 1rem;
        }

        .search-container {
            flex-direction: column;
        }

        .product-table th,
        .product-table td {
            padding: 0.75rem;
            font-size: 0.9rem;
        }

        .action-btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }

        .pagination li {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
    }
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Product Management</h1>
        <div class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a>
            <span>/</span>
            <span>Products</span>
        </div>
    </div>

    <!-- Search and Clear -->
    <div class="search-container">
        <input type="text" id="searchInput" class="search-input" placeholder="Search by product name..." value="<%= searchQuery || ''%>">
        
        <!-- <button class="btn btn-primary" id="search-btn">Search</button> -->

    <button id="search-btn" style="background:none; border:none; cursor:pointer;">
    <i class="fa-solid fa-magnifying-glass" style="font-size:20px; color:green;"></i>
    </button>

        <button class="btn btn-primary" id="clearSearch">Clear</button>

    </div>

    <!-- Product Table -->
    <table class="product-table">
        <thead>
            <tr>
                <th>#</th>  
                <th>Image</th>
                <th>Name</th>
                <th>Regular Price</th>
                <th>Sale Price</th>
                <th>Quantity</th>
                <!-- <th>Category</th> -->
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        
        <tbody id="productTableBody">

            <% if (products.length === 0){ %>
                <tr>
                    <td colspan="8" style="text-align: center; color: var(--gray); padding: 20px; ">No Products found</td>
                </tr>
            <% }else{ %>

            <% products.forEach((product, index)=>{ %>
                <tr>
                    <td><%= (currentPage - 1) * limit + index + 1 %></td>
                    <td>

                        <% if(product.productImage && product.productImage.length > 0){ %>
                        <% product.productImage.forEach(img => { %>
                        <img src="<%= img %>" alt="<%= product.productName %>" style="width:50px;height:50px;object-fit:cover;margin-right:5px;">
                        <% }) %>

                       <% }else{ %>

                    <span>No image</span>
                    
                    <% } %>  

                    </td>
                    
                    <td><%= product.productName %></td>
                    <td><%= product.regularPrice.toFixed(2) %></td>
                    <td><%= product.salePrice.toFixed(2) %></td>
                    <td><%= product.quantity %></td>
                    <td><%= product.status || 'Active' %></td>
                    <td>
                        <button class="edit-btn" id="edit-btn" onclick="window.location.href='/admin/edit-product/<%= product._id %>'">Edit</button>
                       <% if(product.status === 'Inactive'){ %>

                        <button class="block-btn" id="block-btn" onclick="toggleStatus('<%= product._id %>','unblock')">Unblock</button>

                       <% }else{ %>
                        <button class="unblock-btn" id="unblock-btn" onclick="toggleStatus('<%= product._id %>','block')">Block</button>
    
                      <% } %>

                      <button onclick="deleteProduct('<%= product._id %>')" 
                      style="background:none; border:none; cursor:pointer;">
                      <span class="material-icons" style="font-size:25px; color:red; text-align: center;">delete</span>
                      </button>

                    </td>
                </tr>

           <% }) %>
           <% } %>
        </tbody>
</table>


<!-- Pagination -->
    <div class="pagination-container">
        <ul class="pagination">
            <li class="<%= currentPage === 1 ? 'disabled' : '' %>" onclick="<%= currentPage === 1 ? '' : `window.location.href='/admin/products?page=${currentPage - 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">previous</li>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="<%= currentPage === i ? 'active' : '' %>" onclick="window.location.href='/admin/products?page=<%= i %>&search=<%= encodeURIComponent(searchQuery || '') %>'"><%= i %></li>
            <% } %>
            <li class="<%= currentPage === totalPages ? 'disabled' : '' %>" onclick="<%= currentPage === totalPages ? '' : `window.location.href='/admin/products?page=${currentPage + 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Next</li>
        </ul>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>


<script>

    //Search handler
    document.getElementById('search-btn').addEventListener('click',()=>{
        const query = document.getElementById('searchInput').value.trim()
        window.location.href = `/admin/products?search=${encodeURIComponent(query)}&page=1`

    })

    //Clear Search
    document.getElementById('clearSearch').addEventListener('click',()=>{
        window.location.href = '/admin/products?page=1'
    })

    async function deleteProduct(productId){
        const result = await Swal.fire({
            icon:'warning',
            title:'Delete Product?',
            text:"This action cannot be undone!",
            showCancelButton:true,
            cancelButtonColor:'#6c757d',
            confirmButtonText:'Yes,Delete',
            confirmButtonColor:'#FF6B00'
        })

        if(result.isConfirmed){
            try{
                const res = await fetch(`/admin/delete-product/${productId}`,{
                    method:"DELETE"
                })
                const data = await res.json()

                if(res.ok){
                    Swal.fire({
                        icon:'success',
                        text:'Product has been deleted',
                        title:'Deleted'

                    }).then(()=>{
                        window.location.reload()
                    })
                }else{
                    Swal.fire({
                        icon:'error',
                        title:'Oops...!',
                        text:data.message    
                    })
                }
            }catch(error){
                Swal.fir({
                    icon:'error',
                    title:'Error',
                    text:'Server error'
                })
            }
        }
    }



//Block & unblock handler
async function toggleStatus(productId, action){
    const actionText = action === 'block'?'Block':'Unblock'
    const statusText = action === 'block'?'Inactive':'Active'

    const result = await Swal.fire({
        icon:'warning',
        title:`${actionText} this product`,
        text:`Are you sure you want to ${actionText} this product?`,
        showCancelButton:true,
        cancelButtonColor:'#6c757d',
        confirmButtonText:`Yes, ${actionText}`,
        confirmButtonColor:'#FF6B00'

    })

    if(result.isConfirmed){
        try{
            const res = await fetch(`/admin/${action}-products/${productId}`,{
                method:'POST',
                headers:{'Content-Type':'application/json'}
            })
            const data = await res.json()

            if(res.ok){
                Swal.fire({
                    icon:'success',
                    text:`product has been ${actionText} successfully`,
                    title:'success'
                }).then(()=>{
                    window.location.reload()
                })
            }else{
                Swal.fire({
                    icon:'error',
                    title:'Oops...!',
                    text:data.message

                })
            }
        }catch(error){
            Swal.fire({
                icon:'error',
                title:'Error!',
                text:'Server error'

        })
        }
    }
}



</script>


<%- include("../../views/partials/admin/footer") %>
