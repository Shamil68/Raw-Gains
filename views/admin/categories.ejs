<%- include("../../views/partials/admin/header") %>

<style>
    /* Reuse the CSS from products.ejs */
    .main-content {
        padding: 2rem;
        background-color: #f8f9fa;
        min-height: calc(100vh - 160px);
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        color: #FF6B00;
    }

    .search-container {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        max-width: 600px;
    }

    .search-input {
        flex-grow: 1;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .search-input:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: #FF6B00;
        color: white;
    }

    .btn-primary:hover {
        background-color: #e65b00;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }

    .btn-outline:hover {
        background-color: #f1f3f5;
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .category-table th,
    .category-table td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .category-table th {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #2c3e50;
    }

    .category-table tr:hover {
        background-color: #f1f3f5;
    }

    .action-btn {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        border-radius: 6px;
        margin-right: 0.5rem;
    }

    .edit-btn {
        background-color: #3498db;
        color: white;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        border: none;
    }

    .delete-btn {
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        color: white;
        background-color: rgb(232, 7, 7);
        border: none;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
    }

    .pagination {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
    }

    .pagination li {
        padding: 0.5rem 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .pagination li.active {
        background-color: #FF6B00;
        color: white;
        border-color: #FF6B00;
    }

    .pagination li:hover:not(.disabled) {
        background-color: #f1f3f5;
    }

    .pagination li.disabled {
        color: #6c757d;
        cursor: not-allowed;
    }

    @media (max-width: 768px) {
        .main-content {
            padding: 1rem;
        }

        .search-container {
            flex-direction: column;
        }

        .category-table th,
        .category-table td {
            padding: 0.75rem;
            font-size: 0.9rem;
        }

        .action-btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }

        .pagination li {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
    }
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Category Management</h1>
        <div class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a>
            <span>/</span>
            <span>Categories</span>
        </div>
    </div>

    <!-- Search and Clear -->
    <div class="search-container">
        <input type="text" id="searchInput" class="search-input" placeholder="Search by category name..." value="<%= searchQuery || '' %>">
        <button id="search-btn" style="background:none; border:none; cursor:pointer;">
            <i class="fa-solid fa-magnifying-glass" style="font-size:20px; color:green;"></i>
        </button>
        <button class="btn btn-primary" id="clearSearch">Clear</button>
    </div>

    <!-- Category Table -->
    <table class="category-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="categoryTableBody">
            <% if (categories.length === 0) { %>
                <tr>
                    <td colspan="4" style="text-align: center; color: var(--gray); padding: 20px;">No Categories found</td>
                </tr>
            <% } else { %>
                <% categories.forEach((category, index) => { %>
                    <tr>
                        <td><%= (currentPage - 1) * limit + index + 1 %></td>
                        <td><%= category.name %></td>
                        <td><%= category.description || 'N/A' %></td>
                        <td>
                            <button class="edit-btn" onclick="window.location.href='/admin/edit-category/<%= category._id %>'">Edit</button>
                            <button class="delete-btn" onclick="softDeleteCategory('<%= category._id %>')">Delete</button>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="pagination-container">
        <ul class="pagination">
            <li class="<%= currentPage === 1 ? 'disabled' : '' %>" onclick="<%= currentPage === 1 ? '' : `window.location.href='/admin/categories?page=${currentPage - 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Previous</li>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="<%= currentPage === i ? 'active' : '' %>" onclick="window.location.href='/admin/categories?page=<%= i %>&search=<%= encodeURIComponent(searchQuery || '') %>'"><%= i %></li>
            <% } %>
            <li class="<%= currentPage === totalPages ? 'disabled' : '' %>" onclick="<%= currentPage === totalPages ? '' : `window.location.href='/admin/categories?page=${currentPage + 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Next</li>
        </ul>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<script>

    
async function softDeleteCategory(categoryId) {
        const confirmDelete = await Swal.fire({
            title: 'Are you sure?',
            text: 'This category will be soft deleted!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#FF6B00',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete!'
        });

        if (confirmDelete.isConfirmed) {
            try {
                const response = await fetch(`/admin/delete-category/${categoryId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    // body:JSON.stringify({id})
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: data.message,
                        confirmButtonColor: '#FF6B00'
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message,
                        confirmButtonColor: '#FF6B00'
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Server error.Please try again later.',
                    confirmButtonColor: '#FF6B00'
                });
                console.error('Fetch error:', error);
            }
        }
    }



    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('search-btn');
        const clearSearch = document.getElementById('clearSearch');

        searchBtn.addEventListener('click', () => {
            const query = searchInput.value.trim();
            window.location.href = `/admin/categories?page=1&search=${encodeURIComponent(query)}`;
        });

        clearSearch.addEventListener('click', () => {
            searchInput.value = '';
            window.location.href = '/admin/categories?page=1';
        });
    })

   
</script>

<%- include("../../views/partials/admin/footer") %>