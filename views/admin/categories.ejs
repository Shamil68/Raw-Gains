<%- include("../../views/partials/admin/header") %>

<style>
    .main-content {
        padding: 2rem;
        background-color: #f8f9fa;
        min-height: calc(100vh - 160px);
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: #6c757d;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        color: #FF6B00;
    }

    .tabs {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        border-bottom: 2px solid #ddd;
    }

    .tab-button {
        padding: 0.75rem 1.5rem;
        border: none;
        background: none;
        cursor: pointer;
        font-weight: 500;
        color: #6c757d;
        transition: all 0.3s ease;
    }

    .tab-button.active {
        color: #FF6B00;
        border-bottom: 2px solid #FF6B00;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .search-container {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        max-width: 600px;
    }

    .search-input {
        flex-grow: 1;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .search-input:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: #FF6B00;
        color: white;
    }

    .btn-primary:hover {
        background-color: #e65b00;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }

    .btn-outline:hover {
        background-color: #f1f3f5;
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .category-table th,
    .category-table td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .category-table th {
        background-color: #f8f9fa;
        font-weight: 600;
        color: #2c3e50;
    }

    .category-table tr:hover {
        background-color: #f1f3f5;
    }

    .action-btn {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        border-radius: 6px;
        margin-right: 0.5rem;
    }

    .edit-btn {
        background-color: #3498db;
        color: white;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        border: none;
    }

    .delete-btn {
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        color: white;
        background-color: rgb(232, 7, 7);
        border: none;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
    }

    .pagination {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
    }

    .pagination li {
        padding: 0.5rem 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .pagination li.active {
        background-color: #FF6B00;
        color: white;
        border-color: #FF6B00;
    }

    .pagination li:hover:not(.disabled) {
        background-color: #f1f3f5;
    }

    .pagination li.disabled {
        color: #6c757d;
        cursor: not-allowed;
    }

    .form-container {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .form-header {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #ddd;
    }

    .form-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .form-header p {
        color: #6c757d;
        margin-top: 0.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #2c3e50;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .error {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .form-actions {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #ddd;
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    @media (max-width: 992px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .main-content {
            padding: 1rem;
        }

        .tabs {
            flex-direction: column;
        }

        .tab-button {
            padding: 0.5rem 1rem;
        }

        .form-container {
            padding: 1.5rem;
        }
        
        .form-actions {
            flex-direction: column;
        }
        
        .btn {
            width: 100%;
        }
    }
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Category Management</h1>
        <div class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a>
            <span>/</span>
            <span>Categories</span>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
        <button class="tab-button active" onclick="openTab('categoryList')">Category List</button>
        <button class="tab-button" onclick="openTab('addCategory')">Add Category</button>
    </div>

    <!-- Category List Tab -->
    <div id="categoryList" class="tab-content active">
        <!-- Search and Clear -->
        <div class="search-container">
            <input type="text" id="searchInput" class="search-input" placeholder="Search by category name..." value="<%= searchQuery || '' %>">
            <button id="search-btn" style="background:none; border:none; cursor:pointer;">
                <i class="fa-solid fa-magnifying-glass" style="font-size:20px; color:green;"></i>
            </button>
            <button class="btn btn-primary" id="clearSearch">Clear</button>
        </div>

        <!-- Category Table -->
        <table class="category-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="categoryTableBody">
    <% if (categories.length === 0) { %>
        <tr>
            <td colspan="5" style="text-align: center; color: var(--gray); padding: 20px;">No Categories found</td>
        </tr>
    <% } else { %>
        <% categories.forEach((category, index) => { %>
            <tr>
                <td><%= (currentPage - 1) * limit + index + 1 %></td>
                <td><%= category.name %></td>
                <td><%= category.description || 'N/A' %></td>
                
                <!-- 🔽 ithu puthiya td -->
                <td>
                    <% if (!category.isListed) { %>
                        <span style="color:red;">Unlisted</span>
                    <% } else { %>
                        <span style="color:green;">Listed</span>
                    <% } %>
                </td>   
                <!-- 🔼 -->

                <td>
                    <button class="edit-btn" onclick="window.location.href='/admin/edit-category/<%= category._id %>'">Edit</button>
                    
                    <% if (!category.isListed) { %>
                        <button class="delete-btn" onclick="toggleCategory('<%= category._id %>')" style="background-color: green;">List</button>
                    <% } else { %>
                        <button class="delete-btn" onclick="toggleCategory('<%= category._id %>')" style="background-color: red;">Unlist</button>
                    <% } %>
                </td>
            </tr>
        <% }) %>
    <% } %>
</tbody>

        </table>

        <!-- Pagination -->
        <div class="pagination-container">
            <ul class="pagination">
                <li class="<%= currentPage === 1 ? 'disabled' : '' %>" onclick="<%= currentPage === 1 ? '' : `window.location.href='/admin/categories?page=${currentPage - 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Previous</li>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="<%= currentPage === i ? 'active' : '' %>" onclick="window.location.href='/admin/categories?page=<%= i %>&search=<%= encodeURIComponent(searchQuery || '') %>'"><%= i %></li>
                <% } %>
                <li class="<%= currentPage === totalPages ? 'disabled' : '' %>" onclick="<%= currentPage === totalPages ? '' : `window.location.href='/admin/categories?page=${currentPage + 1}&search=${encodeURIComponent(searchQuery || '')}'` %>">Next</li>
            </ul>
        </div>
    </div>

    <!-- Add Category Tab -->
    <div id="addCategory" class="tab-content">
        <div class="form-container">
            <div class="form-header">
                <h2>Category Information</h2>
                <p>Fill in the details below to add a new category to your store</p>
            </div>

            <form id="add-category-form" action="/admin/add-category" method="POST">
                <div class="form-grid">
                    <!-- Category Name -->
                    <div class="form-group full-width">
                        <label for="categoryName">Category Name *</label>
                        <input type="text" name="categoryName" id="categoryName" class="form-control" placeholder="Enter category name">
                        <span class="error" id="name-error"></span>
                    </div>

                    <!-- Description -->
                    <div class="form-group full-width">
                        <label for="description">Description</label>
                        <textarea name="description" id="description" class="form-control" placeholder="Enter category description" rows="4"></textarea>
                        <span class="error" id="description-error"></span>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="openTab('categoryList')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

<script>
    function openTab(tabName) {
        document.querySelectorAll('.tab-button').forEach(button => button.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        document.querySelector(`.tab-button[onclick="openTab('${tabName}')"]`).classList.add('active');
        document.getElementById(tabName).classList.add('active');
    }

    async function toggleCategory(categoryId) {
        const confirmDelete = await Swal.fire({
            title: 'Are you sure?',
            text: 'This category will be Change its status!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#FF6B00',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Sure!'
        });

        if (confirmDelete.isConfirmed){
            try {
                const response = await fetch(`/admin/set-category/${categoryId}`, {
                    method: 'POST',
                    // headers:{'Content-Type':'application/json'},
                    // body:JSON.stringify({action})
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Done!',
                        text: data.message,
                        confirmButtonColor: '#FF6B00'
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message,
                        confirmButtonColor: '#FF6B00'
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Server error. Please try again later.',
                    confirmButtonColor: '#FF6B00'
                });
                console.error('Fetch error:', error);
            }
    }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('search-btn');
        const clearSearch = document.getElementById('clearSearch');

        searchBtn.addEventListener('click', () => {
            const query = searchInput.value.trim();
            window.location.href = `/admin/categories?page=1&search=${encodeURIComponent(query)}`;
        });

        clearSearch.addEventListener('click', () => {
            searchInput.value = '';
            window.location.href = '/admin/categories?page=1';
        });

        const form = document.getElementById('add-category-form');
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            document.querySelectorAll('.error').forEach(element => element.textContent = '');

            const categoryName = document.getElementById('categoryName').value.trim();
            const description = document.getElementById('description').value.trim();

            let isValid = true;

            if (!categoryName) {
                document.getElementById('name-error').textContent = 'Category name required';
                isValid = false;
            } else if (categoryName.length < 3 || categoryName.length > 30) {
                document.getElementById('name-error').textContent = 'Category name must be between 3 to 30 characters';
                isValid = false;
            }
            if (!description) {
                document.getElementById('description-error').textContent = 'Description required';
                isValid = false;
            } else if (description.length < 3) {
                document.getElementById('description-error').textContent = 'Description must have minimum 3 characters';
                isValid = false;
            }
            if (!isValid) return;

            try {
                const res = await fetch('/admin/add-category', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ categoryName, description })
                });

                const data = await res.json();

                if (res.status === 400) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message
                    });
                } else if (res.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: "Category added successfully"
                    }).then(() => {
                        window.location.href = '/admin/categories'; // Refresh to show updated list
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: 'Something went wrong',
                        text: data.message
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: "error",
                    title: 'Error',
                    text: 'Server error'
                });
            }
        });
    });
</script>

<%- include("../../views/partials/admin/footer") %>