<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RawGains - Admin Login</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f0f0f0;
        }
        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
        }
        .error {
            color: red;
            font-size: 0.9em;
            text-align: left;
            margin: 5px 0 10px 0;
        }
        .form-box {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            width: 300px;
            text-align: center;
        }
        .form-box h2 {
            margin-bottom: 20px;
            color: #333;
        }
        .form-box input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .form-box button {
            width: 100%;
            padding: 10px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .form-box button:hover {
            background-color: #218838;
        }
        .form-box a {
            color: #007bff;
            text-decoration: none;
            display: block;
            margin-top: 10px;
        }
        .form-box a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-box">
            <h2>Admin Login</h2>
            <p>Access the RawGains admin panel</p>
            <form id="admin-login-form" action="/admin/login" method="POST">
                <input type="email" name="email" placeholder="Email" id="email">
                <div class="error" id="email-error"></div>

                <div class="password-container" style="position: relative; width: 250px;">
                <input type="password" name="password" id="password" placeholder="Password" style="width:100%; padding-right: 40px;">
                <div class="error" id="password-error"></div>
                <i class="fas fa-eye" id="togglePassword" style="position:absolute; right:-30px; top:50%; transform:translateY(-50%); cursor:pointer;"></i>
                </div>   

                <button type="submit">Login</button>
                <!-- <a href="/admin-login">User Login</a> -->
            </form>
        </div>
    </div>

    <script>

        document.getElementById('togglePassword').addEventListener('click',()=>{
            const passwordField = document.getElementById('password')
            const type = passwordField.type === 'password'?'text':'password'
            passwordField.type = type
            this.classList.toggle('fa-eye-slash')
        })

        
        const form = document.getElementById('admin-login-form')

        form.addEventListener('submit',async(e)=>{
            e.preventDefault()

        document.querySelectorAll('.error').forEach(element => element.textContent = '')

        const email = document.getElementById('email').value.trim()
        const password = document.getElementById('password').value

        let isValid = true

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

        if(!email){
            document.getElementById('email-error').textContent = 'Email required'
            isValid = false
        }else if(!emailRegex.test(email)){
            document.getElementById('email-error').textContent = 'Email must be valid'
            isValid = false
        }

        if(!password){
            document.getElementById('password-error').textContent = 'Password required'
            isValid = false
        }

        if(!isValid) return

        try{
            const res = await fetch('/admin/admin-login',{
                method:'POST',
                headers:{'Content-Type':'application/json'},
                body:JSON.stringify({email:email.toLowerCase(),password}),
                credentials:'include'
            })

            const data = await res.json()

            if(res.status === 400){
                Swal.fire({
                    icon:'error',
                    title:'Oops...',
                    text:data.message

                })

            }else if(res.ok){
                Swal.fire({
                    icon:'success',
                    title:'success',
                    text:'Welcome to admin panel'
                }).then(()=>{
                    window.location.href = data.redirect
                })
            }else{
                Swal.fire({
                    icon:'error',
                    title:'Something went wrong',
                    text:data.message
                })
            }
        }catch(error){
            Swal.fire({
                icon:'error',
                title:'error',
                text:'Server not reachable'
            })
        }

        })
      
    </script>
</body>
</html>