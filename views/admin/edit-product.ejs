<%- include("../partials/admin/header") %>

<style>
    /* Main content area styling */
    .main-content {
        padding: 2rem;
        background-color: #f8f9fa;
        min-height: calc(100vh - 160px);
        font-family: 'Inter', sans-serif;
    }

    /* Page header styling */
    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: #6c757d;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
        color: #FF6B00;
    }

    /* Form container styling */
    .form-container {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .form-header {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e9ecef;
    }

    .form-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .form-header p {
        color: #6c757d;
        margin-top: 0.5rem;
    }

    /* Form grid layout */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    /* Form group styling */
    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #2c3e50;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #FF6B00;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    /* Error message styling */
    .error {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    /* Image preview styling */
    #image-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .preview-item {
        position: relative;
        width: 120px;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .preview-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .crop-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        padding: 2px 5px;
        background-color: #2ecc71;
        color: white;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 0.75rem;
    }

    .crop-btn:hover {
        background-color: #27ae60;
    }

    .delete-btn {
        position: absolute;
        bottom: 5px;
        left: 5px;
        padding: 2px 5px;
        background-color: #dc3545;
        color: white;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 0.75rem;
    }

    .delete-btn:hover {
        background-color: #c82333;
    }

    /* Add image option styling */
    .add-image-option {
        width: 100%;
        height: 100%;
        border: 2px dashed #ddd;
        border-radius: 8px;
        text-align: center;
        padding: 1rem;
        background-color: rgba(44, 62, 80, 0.1);
        cursor: pointer;
        position: relative;
        z-index: 10;
    }

    .add-image-option:hover {
        border-color: #FF6B00;
        background-color: rgba(255, 107, 0, 0.05);
    }

    .add-image-input {
        display: none;
        pointer-events: none;
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .add-image-text {
        color: #6c757d;
        font-size: 0.85rem;
        margin: 0;
        pointer-events: none;
    }

    .add-image-text strong {
        color: #FF6B00;
    }

    /* Form actions styling */
    .form-actions {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: #FF6B00;
        color: white;
    }

    .btn-primary:hover {
        background-color: #e65b00;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #6c757d;
        color: #6c757d;
    }

    .btn-outline:hover {
        background-color: #f1f3f5;
    }

    /* Cropper modal styling */
    .modal-content {
        border-radius: 8px;
    }

    .modal-header {
        background-color: #2c3e50;
        color: white;
        border-radius: 8px 8px 0 0;
    }

    .modal-title {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .modal-body {
        padding: 20px;
        max-height: 90vh;
        overflow-y: auto;
    }

    #cropper-container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
    }

    #cropper-image {
        max-width: 100%;
        width: auto;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    .cropper-actions {
        margin-top: 20px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    /* Responsive adjustments */
    @media (max-width: 992px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .main-content {
            padding: 1rem;
        }

        .form-container {
            padding: 1.5rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }

        .modal-body {
            padding: 15px;
        }

        #cropper-container {
            max-width: 100%;
        }
    }
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Edit Product: <%= product.productName %></h1>
        <div class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a>
            <span>/</span>
            <a href="/admin/products">Products</a>
            <span>/</span>
            <span>Edit</span>
        </div>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <div class="form-header">
            <h2>Update Product Information</h2>
            <p>Modify the details below to update the product (minimum 3 images required)</p>
        </div>

        <form id="edit-product-form" action="/admin/edit-product/<%= product._id %>" method="POST" enctype="multipart/form-data">
            <input type="hidden" id="productId" value="<%= product._id %>">

            <div class="form-grid">
                <!-- Product Name -->
                <div class="form-group full-width">
                    <label for="productName">Product Name *</label>
                    <div class="input-with-icon">
                        <input type="text" name="productName" id="productName" class="form-control" value="<%= product.productName %>" placeholder="Enter product name">
                        <i class="fas fa-box input-icon"></i>
                    </div>
                    <span class="error" id="name-error"></span>
                </div>

                <!-- Description -->
                <div class="form-group full-width">
                    <label for="description">Description *</label>
                    <textarea name="description" id="description" class="form-control" placeholder="Enter product description" rows="4"><%= product.description %></textarea>
                    <span class="error" id="description-error"></span>
                </div>

                <!-- Regular Price -->
                <div class="form-group">
                    <label for="regularPrice">Regular Price ($) *</label>
                    <div class="input-with-icon">
                        <input type="number" name="regularPrice" id="regularPrice" class="form-control" value="<%= product.regularPrice.toFixed(2) %>" placeholder="0.00" step="0.01" min="0">
                        <i class="fas fa-dollar-sign input-icon"></i>
                    </div>
                    <span class="error" id="regularPrice-error"></span>
                </div>

                <!-- Sale Price -->
                <div class="form-group">
                    <label for="salePrice">Sale Price ($) *</label>
                    <div class="input-with-icon">
                        <input type="number" name="salePrice" id="salePrice" class="form-control" value="<%= product.salePrice.toFixed(2) %>" placeholder="0.00" step="0.01" min="0">
                        <i class="fas fa-dollar-sign input-icon"></i>
                    </div>
                    <span class="error" id="salePrice-error"></span>
                </div>

                <!-- Quantity -->
                <div class="form-group">
                    <label for="quantity">Quantity *</label>
                    <div class="input-with-icon">
                        <input type="number" name="quantity" id="quantity" class="form-control" value="<%= product.quantity %>" placeholder="0" min="0">
                        <i class="fas fa-cubes input-icon"></i>
                    </div>
                    <span class="error" id="quantity-error"></span>
                </div>

                <!-- Category -->
<div class="form-group">
    <label for="category">Category *</label>
    <select name="category" id="category" class="form-control">
        <option value="" disabled>Select a category</option>
        <% categories.forEach(cat => { %>
            <option value="<%= cat._id %>" <%= product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
        <% }) %>
    </select>
    <span class="error" id="category-error"></span>
</div>

                <!-- Product Images -->
                <div class="form-group full-width">
                    <label>Product Images * (Minimum 3 required)</label>
                    <span class="error" id="images-error"></span>
                    <!-- Show existing images and placeholders -->
                    <div id="image-preview" class="d-flex flex-wrap">
                        <% 
                            let validImages = (product.productImage || []).filter(img => img && img.trim() !== '');
                            let initialSlotCount = Math.max(3, product.productImage.length || 0); // Use original length, min 3
                            for (let index = 0; index < initialSlotCount; index++) { 
                        %>
                            <% if (index < product.productImage.length && product.productImage[index] && product.productImage[index].trim() !== '') { %>
                                <div class="preview-item m-2 text-center" data-existing-image="<%= product.productImage[index] %>" data-index="<%= index %>">
                                    <img src="<%= product.productImage[index] %>" class="preview-image" alt="Product Image">
                                    <button type="button" class="crop-btn">Crop</button>
                                    <button type="button" class="delete-btn" data-product-id="<%= product._id %>" data-image-url="<%= product.productImage[index] %>">Delete</button>
                                    <div class="add-image-option" style="display: none;">
                                        <p class="add-image-text">Add <strong>new image</strong></p>
                                        <input type="file" class="add-image-input" accept="image/*" data-index="<%= index %>">
                                    </div>
                                </div>
                            <% } else if (index < initialSlotCount) { %>
                                <div class="preview-item m-2 text-center" data-index="<%= index %>">
                                    <img src="<%= product.productImage[index] %>" class="preview-image" style="display: none;" alt="Product Image">
                                    <button type="button" class="crop-btn" style="display: none;">Crop</button>
                                    <button type="button" class="delete-btn" style="display: none;">Delete</button>
                                    <div class="add-image-option">
                                        <p class="add-image-text">Add <strong>new image</strong></p>
                                        <input type="file" class="add-image-input" accept="image/*" data-index="<%= index %>">

                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                    <!-- Hidden input for initial slot count -->
                    <input type="hidden" name="initialSlotCount" id="initialSlotCount" value="<%= initialSlotCount %>">
                </div>
            </div>

            <!-- Hidden input for current images -->
<input type="hidden" name="productImage" id="existingImages" value='<%= JSON.stringify((product.productImage || []).filter(img => img && img.trim() !== "")) %>'>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-outline" onclick="window.location.href='/admin/products'">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Product</button>
            </div>
        </form>
    </div>
</div>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" aria-labelledby="cropperModalLabel" aria-hidden="true" hidden>
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cropperModalLabel">Crop Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="cropper-container">
                    <img id="cropper-image" src="" alt="Image to Crop">
                </div>
                <div class="cropper-actions">
                    <button type="button" class="btn btn-primary" id="cropImageBtn">Crop & Save</button>
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>  
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>
<script>


    document.addEventListener('DOMContentLoaded', (e) => {  
        e.preventDefault()
        // DOM elements
        const form = document.getElementById('edit-product-form');
        const imagePreview = document.getElementById('image-preview');
        const cropperModal = new bootstrap.Modal(document.getElementById('cropperModal'));
        const cropperImage = document.getElementById('cropper-image');
        const cropImageBtn = document.getElementById('cropImageBtn');
        let cropper = null;
        let currentImageIndex = -1;
        let selectedFiles = [];
        let croppedFiles = [];
        let existingImages = JSON.parse(document.getElementById('existingImages').value || '[]');
        let isSingleImageCrop = false;
        let initialSlotCount = parseInt(document.getElementById('initialSlotCount').value || '3');

        // Initialize croppedFiles with existing images based on initialSlotCount
        function initializeCroppedFiles() {
            croppedFiles = Array(initialSlotCount).fill(null);
            existingImages.forEach((img, index) => {
                if (index < initialSlotCount) croppedFiles[index] = { path: img, isExisting: true };
            });
        }
        initializeCroppedFiles();

        // Function to update preview items
        function updatePreviewItems() {
            imagePreview.innerHTML = '';
            const slotsToRender = initialSlotCount; // Use initial slot count consistently
            for (let index = 0; index < slotsToRender; index++) {
                const previewItem = document.createElement('div');
                previewItem.className = 'preview-item m-2 text-center';
                previewItem.dataset.index = index;

                if (croppedFiles[index] && croppedFiles[index].path) {
                    const img = document.createElement('img');
                    // img.src = croppedFiles[index].path;
                    img.src = croppedFiles[index].isExisting ? croppedFiles[index].path : URL.createObjectURL(croppedFiles[index].file);
                    img.className = 'preview-image';
                    img.alt = 'Product Image';

                    const cropBtn = document.createElement('button');
                    cropBtn.className = 'crop-btn';
                    cropBtn.type = 'button';
                    cropBtn.innerText = 'Crop';

                    const deleteBtn = document.createElement('button');
                    deleteBtn.className = 'delete-btn';
                    deleteBtn.type = 'button';
                    deleteBtn.innerText = 'Delete';
                    deleteBtn.dataset.productId = '<%= product._id %>';
                    deleteBtn.dataset.imageUrl = croppedFiles[index].path;

                    const addImageOption = document.createElement('div');
                    addImageOption.className = 'add-image-option';
                    addImageOption.style.display = 'none';
                    addImageOption.innerHTML = `
                        <p class="add-image-text">Add <strong>new image</strong></p>
                        <input type="file" class="add-image-input" accept="image/*" data-index="${index}">
                    `;

                    previewItem.appendChild(img);
                    previewItem.appendChild(cropBtn);
                    previewItem.appendChild(deleteBtn);
                    previewItem.appendChild(addImageOption);
                } else {
                    const img = document.createElement('img');
                    img.src = '';
                    img.className = 'preview-image';
                    img.style.display = 'none';
                    img.alt = 'Product Image';

                    const cropBtn = document.createElement('button');
                    cropBtn.className = 'crop-btn';
                    cropBtn.type = 'button';
                    cropBtn.style.display = 'none';
                    cropBtn.innerText = 'Crop';

                    const deleteBtn = document.createElement('button');
                    deleteBtn.className = 'delete-btn';
                    deleteBtn.type = 'button';
                    deleteBtn.style.display = 'none';
                    deleteBtn.innerText = 'Delete';

                    const addImageOption = document.createElement('div');
                    addImageOption.className = 'add-image-option';
                    addImageOption.innerHTML = `
                        <p class="add-image-text">Add <strong>new image</strong></p>
                        <input type="file" class="add-image-input" accept="image/*" data-index="${index}">
                    `;

                    previewItem.appendChild(img);
                    previewItem.appendChild(cropBtn);
                    previewItem.appendChild(deleteBtn);
                    previewItem.appendChild(addImageOption);
                }

                imagePreview.appendChild(previewItem);
            }
            setupImageListeners();
        }

        // Click handler for add-image-option
        function setupImageListeners() {
            // Clear existing listeners to prevent duplicates
            imagePreview.querySelectorAll('.add-image-option').forEach(option => {
                const newOption = option.cloneNode(true);
                option.parentNode.replaceChild(newOption, option);
            });

            // Add new listeners
            imagePreview.querySelectorAll('.add-image-option').forEach(option => {
                option.addEventListener('click', (e) => {
                    console.log('Click detected on add-image-option, index:', e.currentTarget.querySelector('.add-image-input').dataset.index);
                    const input = e.currentTarget.querySelector('.add-image-input');
                    if (input) {
                        console.log('Triggering input.click() for index:', input.dataset.index);
                        input.click();
                    } else {
                        console.log('No add-image-input found in add-image-option');
                    }
                });
            });

            imagePreview.querySelectorAll('.add-image-input').forEach(input => {
                input.addEventListener('change', (e) => {
                    console.log('Add image input changed, index:', e.target.dataset.index, 'files:', e.target.files.length);
                    const file = e.target.files[0];
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                    if (!file || !validTypes.includes(file.type)) {
                        console.log('Invalid file:', file ? file.type : 'No file');
                        Swal.fire({
                            icon: 'error',
                            title: 'Invalid File',
                            text: 'Please select a valid image file (JPEG, JPG, or PNG).',
                            confirmButtonColor: '#FF6B00'
                        });
                        e.target.value = ''; // Clear invalid input
                        return;
                    }
                    console.log('Valid file:', file.name, file.type);
                    currentImageIndex = parseInt(e.target.dataset.index);
                    selectedFiles = [file];
                    isSingleImageCrop = true;
                    e.target.value = ''; // Clear input for next use
                    startCropping();
                });
            });

            // Crop and delete buttons
            imagePreview.querySelectorAll('.preview-item').forEach((item, index) => {
                const cropBtn = item.querySelector('.crop-btn');
                const deleteBtn = item.querySelector('.delete-btn');

                if (cropBtn && cropBtn.style.display !== 'none') {
                    cropBtn.addEventListener('click', () => {
                        console.log('Crop button clicked, index:', index);
                        currentImageIndex = index;
                        isSingleImageCrop = false;
                        cropperImage.src = item.querySelector('.preview-image').src;
                        cropperModal.show();
                        if (cropper) cropper.destroy();
                        cropper = new Cropper(cropperImage, {
                            aspectRatio: 4 / 3,
                            viewMode: 0,
                            autoCropArea: 0.8,
                            scalable: true,
                            zoomable: true,
                            movable: true,
                            minContainerWidth: 1000,
                            minContainerHeight: 600,
                            ready: function() {
                                this.cropper.setCropBoxData({
                                    width: Math.min(this.cropper.getImageData().width, 800),
                                    height: Math.min(this.cropper.getImageData().height, 600),
                                });
                            },
                        });
                    });
                }

               document.querySelectorAll(".delete-btn").forEach((deleteBtn) => {
  deleteBtn.addEventListener("click", async () => {
    const productId = deleteBtn.dataset.productId;
    const imageUrl = deleteBtn.dataset.imageUrl;

    console.log("Delete clicked:", productId, imageUrl); // 🔥 check in console

                        const confirmDelete = await Swal.fire({
                            title: 'Are you sure?',
                            text: 'This image will be permanently deleted!',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#FF6B00',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Yes, delete!'
                        });

                        if (!confirmDelete.isConfirmed) return;

                        try {
                            const res = await fetch(`/admin/delete-product-image/${productId}`,{
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ image: imageUrl })
                            });
                            const data = await res.json();
                            if (data.success) {
                                Swal.fire('Deleted!', 'Image has been removed.', 'success');
                                const deleteIndex = croppedFiles.findIndex(file => file && file.path === imageUrl);
                                if (deleteIndex !== -1) croppedFiles[deleteIndex] = null;
                                existingImages = data.product?.productImage || existingImages.filter(img => img !== imageUrl);
                                document.getElementById('existingImages').value = JSON.stringify(existingImages);
                                initializeCroppedFiles(); // Reinitialize after deletion
                                updatePreviewItems();
                            } else {
                                Swal.fire('Error!', data.message || 'Failed to delete image', 'error');
                            }
                        } catch (err) {
                            Swal.fire('Error!', 'Something went wrong. Try again later.', 'error');
                            console.error(err);
                        }
                    });
                })
            });
        }

        updatePreviewItems();

        // Start cropping process
        function startCropping() {
            console.log('startCropping: currentImageIndex=', currentImageIndex, 'selectedFiles=', selectedFiles.length, 'isSingleImageCrop=', isSingleImageCrop);
            if (isSingleImageCrop && selectedFiles.length === 0) {
                cropperModal.hide();
                return;
            }
            if (currentImageIndex >= initialSlotCount || currentImageIndex < 0) {
                cropperModal.hide();
                return;
            }
            const file = selectedFiles[0];
            if (!file || !['image/jpeg', 'image/jpg', 'image/png'].includes(file.type)) {
                console.log('Invalid or no file, closing modal');
                cropperModal.hide();
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                console.log('FileReader onload: src=', e.target.result.substring(0, 50) + '...');
                cropperImage.src = e.target.result;
                cropperModal.show();
                if (cropper) cropper.destroy();
                cropper = new Cropper(cropperImage, {
                    aspectRatio: 4 / 3,
                    viewMode: 0,
                    autoCropArea: 0.8,
                    scalable: true,
                    zoomable: true,
                    movable: true,
                    minContainerWidth: 1000,
                    minContainerHeight: 600,
                    ready: function() {
                        this.cropper.setCropBoxData({
                            width: Math.min(this.cropper.getImageData().width, 800),
                            height: Math.min(this.cropper.getImageData().height, 600),
                        });
                    },
                });
            };
            reader.onerror = () => {
                console.error('FileReader error for file:', file.name);
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: `Failed to read image ${currentImageIndex + 1}. Please try again.`,
                    confirmButtonText: 'OK'
                });
                cropperModal.hide();
            };
            console.log('Reading file:', file.name);
            reader.readAsDataURL(file);
        }

        // Crop and save image
cropImageBtn.addEventListener('click', () => {
    console.log('cropImageBtn clicked: currentImageIndex=', currentImageIndex, 'isSingleImageCrop=', isSingleImageCrop);
    const canvas = cropper.getCroppedCanvas({ width: 800, height: 600 });
    canvas.toBlob((blob) => {
        const fileName = selectedFiles[0]?.name || `image-${currentImageIndex}.png`;
        const croppedFile = new File([blob], fileName, { type: 'image/png', lastModified: new Date().getTime() });
        croppedFiles[currentImageIndex] = { path: URL.createObjectURL(croppedFile), isExisting: false, file: croppedFile };
        console.log('Cropped file saved at index', currentImageIndex, ':', croppedFile);
        updatePreviewItems();
        updateExistingImages();
        cropperModal.hide();
        Swal.fire({
            icon: 'success',
            title: 'Image Saved!',
            text: `Image ${currentImageIndex + 1} has been ${croppedFiles[currentImageIndex].isExisting ? 'replaced' : 'added'}.`,
            confirmButtonColor: '#FF6B00'
        });
        selectedFiles = [];
        currentImageIndex = -1;
    }, 'image/png');
});

        // Handle modal close
        cropperModal._element.addEventListener('hidden.bs.modal', () => {
            console.log('Modal hidden: isSingleImageCrop=', isSingleImageCrop, 'currentImageIndex=', currentImageIndex, 'selectedFiles=', selectedFiles.length);
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
            selectedFiles = [];
            currentImageIndex = -1;
        });

        // Update existing images input
        function updateExistingImages() {
            const currentImages = croppedFiles.filter(file => file && file.isExisting).map(file => file.path);
            document.getElementById('existingImages').value = JSON.stringify(currentImages);
        }

       // Form submission handler

        async function handleFormSubmit(e) {
            e.preventDefault();
            const productId = document.getElementById('productId').value
            document.querySelectorAll('.error').forEach(el => el.textContent = '');
            const productName = document.getElementById('productName').value.trim();
            const description = document.getElementById('description').value.trim();
            const regularPrice = document.getElementById('regularPrice').value;
            const salePrice = document.getElementById('salePrice').value;
            const quantity = document.getElementById('quantity').value;
            let isValid = true;

            if (!productName) {
                document.getElementById('name-error').textContent = 'Product name is required';
                isValid = false;
            } else if (productName.length < 3 || productName.length > 30) {
                document.getElementById('name-error').textContent = 'Product name must be between 3 and 30 characters';
                isValid = false;
            } else if (productName.startsWith(' ') || productName.endsWith(' ')) {
                document.getElementById('name-error').textContent = 'Product name cannot start or end with spaces';
                isValid = false;
            } else if (productName.includes('  ')) {
                document.getElementById('name-error').textContent = 'Product name cannot include multiple consecutive spaces';
                isValid = false;
            }

            if (!description) {
                document.getElementById('description-error').textContent = 'Description is required';
                isValid = false;
            } else if (description.length < 3) {
                document.getElementById('description-error').textContent = 'Description must be at least 3 characters';
                isValid = false;
            }

            if (!regularPrice) {
                document.getElementById('regularPrice-error').textContent = 'Regular price is required';
                isValid = false;
            } else if (isNaN(regularPrice) || regularPrice <= 0) {
                document.getElementById('regularPrice-error').textContent = 'Regular price must be a number greater than 0';
                isValid = false;
            }

            if (!salePrice) {
                document.getElementById('salePrice-error').textContent = 'Sale price is required';
                isValid = false;
            } else if (isNaN(salePrice) || salePrice <= 0) {
                document.getElementById('salePrice-error').textContent = 'Sale price must be a number greater than 0';
                isValid = false;
            } else if (parseFloat(salePrice) > parseFloat(regularPrice)) {
                document.getElementById('salePrice-error').textContent = 'Sale price cannot be greater than regular price';
                isValid = false;
            }

            if (!quantity) {
                document.getElementById('quantity-error').textContent = 'Quantity is required';
                isValid = false;
            } else if (isNaN(quantity) || quantity <= 0) {
                document.getElementById('quantity-error').textContent = 'Quantity must be a number greater than 0';
                isValid = false;
            }

            if (!document.getElementById('category').value) {
                document.getElementById('category-error').textContent = 'Category is required';
                isValid = false;
            }

            if (croppedFiles.filter(file => file).length < 3) {
                document.getElementById('images-error').textContent = 'Minimum 3 images are required';
                isValid = false;
            }

            if (!isValid) return;

            const formData = new FormData();
            formData.append('productName', productName);
            formData.append('description', description);
            formData.append('regularPrice', regularPrice);
            formData.append('salePrice', salePrice);
            formData.append('quantity', quantity);
            formData.append('category', document.getElementById('category').value);
            formData.append('productImage', JSON.stringify(croppedFiles.filter(file => file && file.isExisting).map(file => file.path)));
            formData.append('initialSlotCount', initialSlotCount);

            // Append cropped files with explicit logging
            croppedFiles.forEach((file,index) => {
                if (file && !file.isExisting && file.file) {
                    // console.log(`Appending file for image${index + 1}:`, file.file.name);
                    formData.append("images", file.file);
                }
            });

            // Debug log for formData
            for (let [key, value] of formData.entries()) {
                console.log('FormData entry:', key, value instanceof File ? 'File' : value);
            }

            try {
                const response = await fetch(`/admin/edit-product/${productId}`, {
                    method: 'PATCH',
                    body: formData
                });
                const data = await response.json();
                console.log('Server response:', data); // Debug server response
                if (response.status === 400) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message,
                        confirmButtonColor: '#FF6B00'
                    });
                } else if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: 'Product updated successfully',
                        confirmButtonColor: '#FF6B00'
                    }).then(() => {
                        window.location.href = '/admin/products?' + new Date().getTime(); // Force refresh
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Something went wrong',
                        text: data.message || 'Please try again later',
                        confirmButtonColor: '#FF6B00'
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Server error. Please try again later.',
                    confirmButtonColor: '#FF6B00'
                });
                console.error('Fetch error:', error);
            }
        }

        form.addEventListener('submit', handleFormSubmit);
    });

</script>