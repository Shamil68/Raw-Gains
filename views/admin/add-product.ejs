<%- include("../partials/admin/header") %>

<style>
    /* Main content area styling */
    .main-content {
        padding: 2rem;
        background-color: #f8f9fa;
        min-height: calc(100vh - 160px);
    }

    /* Page header styling */
    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 0.5rem;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--gray);
        font-size: 0.9rem;
    }

    .breadcrumb a {
        color: var(--gray);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
        color: var(--primary);
    }

    /* Form container styling */
    .form-container {
        background-color: var(--light);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .form-header {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--gray-light);
    }

    .form-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--dark);
    }

    .form-header p {
        color: var(--gray);
        margin-top: 0.5rem;
    }

    /* Form grid layout */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    /* Form group styling */
    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--dark);
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.1);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .input-with-icon {
        position: relative;
    }

    .input-icon {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--gray);
    }

    /* Error message styling */
    .error {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    /* Image upload styling */
    .image-upload-container {
        border: 2px dashed #ddd;
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .image-upload-container:hover {
        border-color: var(--primary-light);
    }

    .image-upload-container.dragover {
        border-color: var(--primary);
        background-color: rgba(255, 107, 0, 0.05);
    }

    .upload-icon {
        font-size: 2rem;
        color: var(--gray);
        margin-bottom: 1rem;
    }

    .upload-text {
        color: var(--gray);
        margin-bottom: 1rem;
    }

    .upload-text strong {
        color: var(--primary);
    }

    .browse-btn {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background-color: var(--gray-light);
        border-radius: 6px;
        color: var(--dark);
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .browse-btn:hover {
        background-color: #e2e6ea;
    }

    /* Image preview styling */
    #image-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .preview-item {
        position: relative;
        width: 120px;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .preview-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .remove-image {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background-color: rgba(220, 53, 69, 0.8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        transition: all 0.3s ease;
    }

    .remove-image:hover {
        background-color: #dc3545;
    }

    .crop-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        padding: 2px 5px;
        background-color: #2ecc71;
        color: white;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 0.75rem;
    }

    .crop-btn:hover {
        background-color: #27ae60;
    }

    /* Form actions styling */
    .form-actions {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-light);
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--primary-light);
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid var(--gray);
        color: var(--gray);
    }

    .btn-outline:hover {
        background-color: var(--gray-light);
    }

    /* Cropper modal styling */
    .modal-content {
        border-radius: 8px;
    }

    .modal-header {
        background-color: #2c3e50;
        color: white;
        border-radius: 8px 8px 0 0;
    }

    .modal-title {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .modal-body {
        padding: 20px;
        max-height: 90vh;
        overflow-y: auto;
    }

    #cropper-container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
    }

    #cropper-image {
        max-width: 100%;
        width: auto;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    .cropper-actions {
        margin-top: 20px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    /* Responsive adjustments */
    @media (max-width: 992px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .main-content {
            padding: 1rem;
        }
        
        .form-container {
            padding: 1.5rem;
        }
        
        .form-actions {
            flex-direction: column;
        }
        
        .btn {
            width: 100%;
        }

        .modal-body {
            padding: 15px;
        }

        #cropper-container {
            max-width: 100%;
        }
    }
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Add New Product</h1>
        <div class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a>
            <span>/</span>
            <a href="/admin/products">Products</a>
            <span>/</span>
            <span>Add New</span>
        </div>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <div class="form-header">
            <h2>Product Information</h2>
            <p>Fill in the details below to add a new product to your store (minimum 3 images required)</p>
        </div>

        <form id="add-product-form" action="/admin/add-product" method="POST" enctype="multipart/form-data">
            <div class="form-grid">
                <!-- Product Name -->
                <div class="form-group full-width">
                    <label for="productName">Product Name *</label>
                    <div class="input-with-icon">
                        <input type="text" name="productName" id="productName" class="form-control" placeholder="Enter product name">
                        <i class="fas fa-box input-icon"></i>
                    </div>
                    <span class="error" id="name-error"></span>
                </div>

                <!-- Description -->
                <div class="form-group full-width">
                    <label for="description">Description *</label>
                    <textarea name="description" id="description" class="form-control" placeholder="Enter product description" rows="4"></textarea>
                    <span class="error" id="description-error"></span>
                </div>

                <!-- Regular Price -->
                <div class="form-group">
                    <label for="regularPrice">Regular Price ($) *</label>
                    <div class="input-with-icon">
                        <input type="number" name="regularPrice" id="regularPrice" class="form-control" placeholder="0.00" step="0.01" min="0">
                        <i class="fas fa-dollar-sign input-icon"></i>
                    </div>
                    <span class="error" id="regularPrice-error"></span>
                </div>

                <!-- Sale Price -->
                <div class="form-group">
                    <label for="salePrice">Sale Price ($) *</label>
                    <div class="input-with-icon">
                        <input type="number" name="salePrice" id="salePrice" class="form-control" placeholder="0.00" step="0.01" min="0">
                        <i class="fas fa-dollar-sign input-icon"></i>
                    </div>
                    <span class="error" id="salePrice-error"></span>
                </div>

                <!-- Quantity -->
                <div class="form-group">
                    <label for="quantity">Quantity *</label>
                    <div class="input-with-icon">
                        <input type="number" name="quantity" id="quantity" class="form-control" placeholder="0" min="0">
                        <i class="fas fa-cubes input-icon"></i>
                    </div>
                    <span class="error" id="quantity-error"></span>
                </div>

                <!-- Empty div for spacing -->
                <div class="form-group"></div>

                <!-- Image Upload -->
                <div class="form-group full-width">
                    <label>Product Images * (Minimum 3 required)</label>
                    <div class="image-upload-container" id="upload-area">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <p class="upload-text">Drag & drop images here or <strong>browse</strong></p>
                        <div class="browse-btn">Select Images</div>
                        <input type="file" id="images" name="images" multiple accept="image/*" style="display: none;">
                    </div>
                    <span class="error" id="images-error"></span>
                    
                    <!-- Image Preview -->
                    <div id="image-preview"></div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-outline" onclick="window.location.href='/admin/products'">Cancel</button>
                <button type="submit" class="btn btn-primary">Add Product</button>
            </div>
        </form>
    </div>
</div>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" aria-labelledby="cropperModalLabel" aria-hidden="true" hidden>
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cropperModalLabel">Crop Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="cropper-container">
                    <img id="cropper-image" src="" alt="Image to Crop">
                </div>
                <div class="cropper-actions">
                    <button type="button" class="btn btn-primary" id="cropImageBtn">Crop & Save</button>
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
<script>
    // DOM elements
    const form = document.getElementById('add-product-form');
    const uploadArea = document.getElementById('upload-area');
    const fileInput = document.getElementById('images');
    const browseBtn = uploadArea.querySelector('.browse-btn');
    const imagePreview = document.getElementById('image-preview');
    const cropperModal = new bootstrap.Modal(document.getElementById('cropperModal'));
    const cropperImage = document.getElementById('cropper-image');
    const cropImageBtn = document.getElementById('cropImageBtn');
    let cropper = null;
    let currentImageIndex = -1;
    let selectedFiles = [];
    let croppedFiles = [];

    // Event listeners
    browseBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', handleFileSelect);
    uploadArea.addEventListener('dragover', handleDragOver);
    uploadArea.addEventListener('dragleave', handleDragLeave);
    uploadArea.addEventListener('drop', handleDrop);
    form.addEventListener('submit', handleFormSubmit);

    // Drag and drop handlers
    function handleDragOver(e) {
        e.preventDefault();
        e.stopPropagation();
        uploadArea.classList.add('dragover');
    }

    function handleDragLeave(e) {
        e.preventDefault();
        e.stopPropagation();
        uploadArea.classList.remove('dragover');
    }

    function handleDrop(e) {
        e.preventDefault();
        e.stopPropagation();
        uploadArea.classList.remove('dragover');
        
        const files = e.dataTransfer.files;
        if (files.length) {
            fileInput.files = files;
            handleFileSelect();
        }
    }

    // File selection handler
    async function handleFileSelect() {
        const files = Array.from(fileInput.files);
        const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        const maxSize = 5 * 1024 * 1024; // 5MB
        let valid = true;

        files.forEach(file => {
            if (!validTypes.includes(file.type)) {
                valid = false;
                document.getElementById('images-error').textContent = 'Only JPEG, JPG, and PNG images are allowed.';
            }
            if (file.size > maxSize) {
                valid = false;
                document.getElementById('images-error').textContent = 'Each image must be less than 5MB.';
            }
        });

        if (!valid) {
            fileInput.value = '';
            imagePreview.innerHTML = '';
            selectedFiles = [];
            croppedFiles = [];
            return;
        }

        document.getElementById('images-error').textContent = '';
        selectedFiles = files;
        croppedFiles = [];
        imagePreview.innerHTML = '';
        currentImageIndex = 0;
        startCropping();
    }

    // Start cropping process
    function startCropping() {
        if (currentImageIndex >= selectedFiles.length || currentImageIndex < 0) {
            cropperModal.hide();
            return;
        }

        const file = selectedFiles[currentImageIndex];
        if (!file.type.match('image.*')) {
            currentImageIndex++;
            startCropping();
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            cropperImage.src = e.target.result;
            cropperModal.show();

            if (cropper) cropper.destroy();
            cropper = new Cropper(cropperImage, {
                aspectRatio: 4 / 3,
                viewMode: 0,
                autoCropArea: 0.8,
                scalable: true,
                zoomable: true,
                movable: true,
                minContainerWidth: 1000,
                minContainerHeight: 600,
                ready: function() {
                    this.cropper.setCropBoxData({
                        width: Math.min(this.cropper.getImageData().width, 800),
                        height: Math.min(this.cropper.getImageData().height, 600),
                    });
                },
            });
        };
        reader.onerror = () => {
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: `Failed to read image ${currentImageIndex + 1}. Please try again.`,
                confirmButtonText: 'OK'
            });
            currentImageIndex++;
            startCropping();
        };
        reader.readAsDataURL(file);
    }

    // Crop and save image
    cropImageBtn.addEventListener('click', () => {
        const canvas = cropper.getCroppedCanvas({
            width: 800,
            height: 600,
        });

        canvas.toBlob((blob) => {
            const fileName = selectedFiles[currentImageIndex].name;
            const croppedFile = new File([blob], fileName, { type: 'image/png' });
            croppedFiles[currentImageIndex] = croppedFile;

            const previewItem = document.createElement('div');
            previewItem.className = 'preview-item';
            const img = document.createElement('img');
            img.src = URL.createObjectURL(croppedFile);
            img.className = 'preview-image';
            const removeBtn = document.createElement('div');
            removeBtn.className = 'remove-image';
            removeBtn.innerHTML = '<i class="fas fa-times"></i>';
            removeBtn.addEventListener('click', () => {
                croppedFiles.splice(currentImageIndex, 1);
                selectedFiles.splice(currentImageIndex, 1);
                previewItem.remove();
                updateFileInput();
            });
            const cropBtn = document.createElement('button');
            cropBtn.className = 'crop-btn';
            cropBtn.innerText = 'Crop';
            cropBtn.addEventListener('click', () => {
                const index = Array.from(imagePreview.children).indexOf(previewItem);
                currentImageIndex = index;
                cropperImage.src = img.src;
                cropperModal.show();

                if (cropper) cropper.destroy();
                cropper = new Cropper(cropperImage, {
                    aspectRatio: 4 / 3,
                    viewMode: 0,
                    autoCropArea: 0.8,
                    scalable: true,
                    zoomable: true,
                    movable: true,
                    minContainerWidth: 1000,
                    minContainerHeight: 600,
                    ready: function() {
                        this.cropper.setCropBoxData({
                            width: Math.min(this.cropper.getImageData().width, 800),
                            height: Math.min(this.cropper.getImageData().height, 600),
                        });
                    },
                });
            });

            previewItem.appendChild(img);
            previewItem.appendChild(removeBtn);
            previewItem.appendChild(cropBtn);

            if (currentImageIndex < imagePreview.children.length) {
                imagePreview.replaceChild(previewItem, imagePreview.children[currentImageIndex]);
            } else {
                imagePreview.appendChild(previewItem);
            }

            cropperModal.hide();
            Swal.fire({
                icon: 'success',
                title: 'Image Saved!',
                text: `Image ${currentImageIndex + 1} has been cropped and saved.`,
                confirmButtonText: 'OK'
            }).then(() => {
                currentImageIndex++;
                startCropping();
            });
        }, 'image/png');
    });

    // Handle modal close
    cropperModal._element.addEventListener('hidden.bs.modal', () => {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        if (currentImageIndex < selectedFiles.length && currentImageIndex >= 0) {
            startCropping();
        }
    });

    // Update file input with cropped files
    function updateFileInput() {
        const dataTransfer = new DataTransfer();
        croppedFiles.forEach(file => dataTransfer.items.add(file));
        fileInput.files = dataTransfer.files;
    }

    // Form submission handler
    async function handleFormSubmit(e) {
        e.preventDefault();
        
        // Clear previous errors
        document.querySelectorAll('.error').forEach(el => el.textContent = '');
        
        // Get form values
        const productName = document.getElementById('productName').value.trim();
        const description = document.getElementById('description').value.trim();
        const regularPrice = document.getElementById('regularPrice').value;
        const salePrice = document.getElementById('salePrice').value;
        const quantity = document.getElementById('quantity').value;
        const images = croppedFiles;
        
        let isValid = true;
        
        // Validation
        if (!productName) {
            document.getElementById('name-error').textContent = 'Product name is required';
            isValid = false;
        } else if (productName.length < 3 || productName.length > 30) {
            document.getElementById('name-error').textContent = 'Product name must be between 3 and 30 characters';
            isValid = false;
        } else if (productName.startsWith(' ') || productName.endsWith(' ')) {
            document.getElementById('name-error').textContent = 'Product name cannot start or end with spaces';
            isValid = false;
        } else if (productName.includes('  ')) {
            document.getElementById('name-error').textContent = 'Product name cannot include multiple consecutive spaces';
            isValid = false;
        }
        
        if (!description) {
            document.getElementById('description-error').textContent = 'Description is required';
            isValid = false;
        } else if (description.length < 3) {
            document.getElementById('description-error').textContent = 'Description must be at least 3 characters';
            isValid = false;
        }
        
        if (!regularPrice) {
            document.getElementById('regularPrice-error').textContent = 'Regular price is required';
            isValid = false;
        } else if (isNaN(regularPrice) || regularPrice <= 0) {
            document.getElementById('regularPrice-error').textContent = 'Regular price must be a number greater than 0';
            isValid = false;
        }
        
        if (!salePrice) {
            document.getElementById('salePrice-error').textContent = 'Sale price is required';
            isValid = false;
        } else if (isNaN(salePrice) || salePrice <= 0) {
            document.getElementById('salePrice-error').textContent = 'Sale price must be a number greater than 0';
            isValid = false;
        } else if (parseFloat(salePrice) > parseFloat(regularPrice)) {
            document.getElementById('salePrice-error').textContent = 'Sale price cannot be greater than regular price';
            isValid = false;
        }
        
        if (!quantity) {
            document.getElementById('quantity-error').textContent = 'Quantity is required';
            isValid = false;
        } else if (isNaN(quantity) || quantity <= 0) {
            document.getElementById('quantity-error').textContent = 'Quantity must be a number greater than 0';
            isValid = false;
        }
        
        if (images.length < 3) {
            document.getElementById('images-error').textContent = 'Minimum 3 images are required';
            isValid = false;
        }
        
        if (!isValid) return;
        
        // Create form data
        const formData = new FormData();
        formData.append('productName', productName);
        formData.append('description', description);
        formData.append('regularPrice', regularPrice);
        formData.append('salePrice', salePrice);
        formData.append('quantity', quantity);
        
        // croppedFiles.forEach((file, index) => {
        //     formData.append(`image${index + 1}`, file);
        // });

        croppedFiles.forEach(file => {
        formData.append("images", file);   // ✅ match multer field
        });



        
        // Submit form
        try {
            const res = await fetch('/admin/add-product', {
                method: 'POST',
                body: formData
            });
            
            const data = await res.json();
            
            if (res.status === 400) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: data.message
                });
            } else if (res.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: 'Product added successfully'
                }).then(() => {
                    window.location.href = data.redirect;
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Something went wrong',
                    text: data.message || 'Please try again later'
                });
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Server error. Please try again later.'
            });
        }
    }
</script>

<%- include("../partials/admin/footer") %>